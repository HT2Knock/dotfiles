{
	// Read-only base configuration for this machine.
	// settings.json imports this file and always wins on conflict.
	// The GUI writes its changes to settings.json, so keep this file stable.

	"$schema": "https://vicinae.com/schemas/config.json",

	// fcitx5 is available on this system. Search IME preedit text in real time.
	"consider_preedit": true,

	// Search files directly from the root search, not only from the
	// "File Search" command.
	"search_files_in_root": true,

	// Use the theme and the icon theme that match the system appearance.
	// The dark theme matches the Tokyo Night GTK theme used on this system.
	"theme": {
		"light": {
			"name": "vicinae-light",
			"icon_theme": "auto"
		},
		"dark": {
			"name": "tokyo-night",
			"icon_theme": "auto"
		}
	},

	// Show clipboard history first when the search input is empty.
	"favorites": [
		"clipboard:history"
	],

	// Offer file search when no other result matches the query.
	"fallbacks": [
		"files:search"
	]
}