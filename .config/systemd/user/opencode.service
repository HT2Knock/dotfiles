[Unit]
Description=opencode background server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PATH=/home/t2knock/.opencode/bin:/home/t2knock/.local/bin:/home/t2knock/.bun/bin:/home/t2knock/go/bin:/home/t2knock/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/bin:/bin
# The Exa websearch key. systemd does not read shell startup files, so without
# this the server searches anonymously and hits the anonymous rate limit (HTTP 429).
EnvironmentFile=%h/.secrets/opencode-env.zsh
ExecStart=%h/.opencode/bin/opencode serve --service
Restart=on-failure
RestartSec=5
WorkingDirectory=%h

[Install]
WantedBy=default.target
