{
  "$schema": "./opencode.schema.json",
  "model": "opencode-go/deepseek-v4.1-flash",
  "plugins": ["/home/t2knock/workspace/github.com/ht2knockA/opencode-ntfy"],
  "websearch": {
    "provider": "exa",
  },
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "allow" },
    { "action": "read", "resource": "*.env.*", "effect": "allow" },
  ],
  "references": {
    "notes": {
      "path": "~/JT-notes",
      "description": "Second brain: personal notes, runbooks, and research. Search and inspect specific files on demand; do not read the whole tree.",
    },
  },
  "agents": {
    "reviewer": {
      "description": "Fresh-context review of a document, a diff, or a decision trail. Reports findings the author can check.",
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4.1-flash",
    },
  },
  "username": "ngock (ht2knock)",
  "mcp": {
    "servers": {
      "browse": {
        "type": "local",
        "command": ["/home/t2knock/.local/bin/browse", "mcp"],
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
      },
      "grep": {
        "type": "remote",
        "url": "https://mcp.grep.app",
      },
    },
  },
}
