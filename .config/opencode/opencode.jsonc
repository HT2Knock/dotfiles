{
  "$schema": "./opencode.schema.json",
  "plugins": [
    "@ex-machina/opencode-anthropic-auth@next",
    "/Users/ht2knock/personal/opencode-ntfy",
  ],
  "websearch": {
    "provider": "exa",
  },
  "permissions": [{ "action": "external_directory", "resource": "*", "effect": "allow" }],
  "references": {
    "notes": {
      "path": "~/Documents/T2Knock/JT-notes",
      "description": "Second brain: personal notes, runbooks, and research. Search and inspect specific files on demand; do not read the whole tree.",
    },
  },
  "agents": {
    "reviewer": {
      "description": "Fresh-context review of a document, a diff, or a decision trail. Reports findings the author can check.",
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4.1-flash",
    },
  },
  "username": "ngoc (ht2knock)",
  "mcp": {
    "servers": {
      "browser_control": {
        "type": "local",
        "command": [
          "/Users/ht2knock/.local/share/fnm/aliases/default/bin/node",
          "/Users/ht2knock/.browser-control/runtime/current/node_modules/@opencode-ai/browser-control/dist/mcp.js",
        ],
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
      },
      "grep": {
        "type": "remote",
        "url": "https://mcp.grep.app",
      },
    },
  },
}
