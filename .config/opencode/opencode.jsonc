{
  "$schema": "./opencode.schema.json",
  "model": "openai/gpt-6-luna",
  "plugins": ["@ex-machina/opencode-anthropic-auth@next"],
  "websearch": {
    "provider": "exa",
  },
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "allow" },
    { "action": "read", "resource": "*.env.*", "effect": "allow" },
    { "action": "question", "resource": "*", "effect": "deny" },
    { "action": "websearch", "resource": "*", "effect": "allow" },
    { "action": "browser", "resource": "*", "effect": "deny" },
    { "action": "edit", "resource": "/usr/local/bin/*", "effect": "deny" },
    { "action": "edit", "resource": "/etc/sudoers*", "effect": "deny" },
    { "action": "edit", "resource": "/etc/makepkg.conf*", "effect": "deny" },
    { "action": "edit", "resource": "/etc/paru.conf*", "effect": "deny" },
    { "action": "edit", "resource": "/etc/polkit-1/*", "effect": "deny" },
    { "action": "shell", "resource": "sudo *", "effect": "deny" },
    { "action": "shell", "resource": "sudo-gui *", "effect": "deny" },
    { "action": "shell", "resource": "/usr/local/bin/sudo-gui *", "effect": "deny" },
    { "action": "shell", "resource": "pkexec *", "effect": "deny" },
    { "action": "shell", "resource": "run0 *", "effect": "deny" },
    { "action": "shell", "resource": "pacman -Sy *", "effect": "deny" },
    { "action": "shell", "resource": "paru -Sy *", "effect": "deny" },
    { "action": "shell", "resource": "*sudo *", "effect": "deny" },
    { "action": "shell", "resource": "*sudo-gui *", "effect": "deny" },
    { "action": "shell", "resource": "*pkexec *", "effect": "deny" },
    { "action": "shell", "resource": "*run0 *", "effect": "deny" },
    { "action": "shell", "resource": "*pacman -Sy *", "effect": "deny" },
    { "action": "shell", "resource": "*paru -Sy *", "effect": "deny" },
  ],
  "agents": {
    "reviewer": {
      "description": "Fresh-context review of a document, a diff, or a decision trail. Reports findings the author can check.",
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4.1-flash",
    },
  },
  "username": "ngock (ht2knock)",
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest",
          "--no-usage-statistics",
        ],
        "disabled": true,
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
      },
      "grep": {
        "type": "remote",
        "url": "https://mcp.grep.app",
      },
    },
  },
}
