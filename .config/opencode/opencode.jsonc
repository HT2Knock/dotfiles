{
  "$schema": "./opencode.schema.json",
  "plugins": ["@ex-machina/opencode-anthropic-auth@next"],
  "websearch": {
    "provider": "exa",
  },
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "allow" },
    { "action": "read", "resource": "*.env.*", "effect": "allow" },
    { "action": "question", "resource": "*", "effect": "deny" },
    { "action": "websearch", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "/usr/local/bin/*", "effect": "deny" },
    { "action": "edit", "resource": "/etc/sudoers*", "effect": "deny" },
    { "action": "edit", "resource": "/etc/makepkg.conf*", "effect": "deny" },
    { "action": "edit", "resource": "/etc/paru.conf*", "effect": "deny" },
    { "action": "edit", "resource": "/etc/polkit-1/*", "effect": "deny" },
  ],
  "experimental": {
    "policies": [
      { "action": "permission", "resource": "shell:sudo *", "effect": "deny" },
      { "action": "permission", "resource": "shell:sudo-gui *", "effect": "deny" },
      { "action": "permission", "resource": "shell:/usr/local/bin/sudo-gui *", "effect": "deny" },
      { "action": "permission", "resource": "shell:pkexec *", "effect": "deny" },
      { "action": "permission", "resource": "shell:run0 *", "effect": "deny" },
      { "action": "permission", "resource": "shell:pacman -Sy *", "effect": "deny" },
      { "action": "permission", "resource": "shell:paru -Sy *", "effect": "deny" },
    ],
  },
  "username": "ngock (ht2knock)",
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest",
          "--no-usage-statistics",
        ],
        "disabled": true,
      },
      "codebase-memory-mcp": {
        "type": "local",
        "command": ["codebase-memory-mcp"],
        "disabled": true,
      },
      "grep": {
        "type": "remote",
        "url": "https://mcp.grep.app",
      },
    },
  },
}
