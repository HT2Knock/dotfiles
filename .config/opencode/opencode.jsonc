{
  "$schema": "./opencode.schema.json",
  "plugins": ["@ex-machina/opencode-anthropic-auth@next"],
  "websearch": {
    "provider": "exa",
  },
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "allow" },
  ],
  "agents": {
    "explore": {
      "model": "opencode/muse-spark-1.3-contributor-free",
    },
    "general": {
      "model": "opencode/muse-spark-1.3-contributor-free",
    },
  },
  "username": "ngock (ht2knock)",
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest",
          "--no-usage-statistics",
        ],
        "disabled": true,
      },
      "codebase-memory-mcp": {
        "type": "local",
        "command": ["/Users/ht2knock/.local/bin/codebase-memory-mcp"],
      },
    },
  },
}
