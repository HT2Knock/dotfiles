{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@mohak34/opencode-notifier@latest",
    "@ex-machina/opencode-anthropic-auth@latest"
  ],
  "agent": {
    "explore": {
      "model": "opencode-go/hy3"
    },
    "general": {
      "model": "opencode-go/hy3"
    }
  },
  "permission": {
    "external_directory": "allow",
    "*.env": "allow",
    "*.env.*": "allow",
    "question": "deny",
    "websearch": "allow"
  },
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--no-usage-statistics"
      ],
      "enabled": false
    },
    "codebase-memory-mcp": {
      "command": ["/Users/ht2knock/.local/bin/codebase-memory-mcp"],
      "type": "local"
    }
  }
}
