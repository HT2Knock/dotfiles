{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "tokyonight",
    "mode": "system"
  },
  "animations": true,
  "keybinds": {
    "session.half.page.up": "ctrl+u",
    "session.half.page.down": "ctrl+d"
  },
  "diffs": {
    "wrap": "word",
    "view": "split"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "show",
    "markdown": "rendered",
    "permissions": "autoaccept",
    "grouping": "auto",
    "verbosity": "medium"
  },
  "tabs": {
    "layout": "horizontal",
    "scope": "cwd",
    "indicators": "numbers",
    "enabled": false
  },
  "attention": {
    "notifications": false,
    "sound": false
  },
  "prompt": {
    "image_preview": true
  }
}
