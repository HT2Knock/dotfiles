{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "tokyonight"
  },
  "animations": true,
  "session": {
    "scrollbar": true,
    "thinking": "hide",
    "permissions": "prompt",
    "sidebar": "auto"
  },
  "tabs": {
    "scope": "cwd"
  },
  "attention": {
    "notifications": true,
    "sound": true,
    "volume": 0.4,
    "sound_pack": "opencode.default"
  },
  "plugins": ["./herdr-opencode"],
  "prompt": {
    "image_preview": true
  }
}
