{
  "$schema": "https://opencode.ai/v2/cli.json",
  "plugins": ["./tui-plugins/rex-status"],
  "theme": {
    "name": "tokyonight"
  },
  "keybinds": {
    "app.exit": "ctrl+c,<leader>q",
    "session.half.page.up": "ctrl+u",
    "session.half.page.down": "ctrl+d",
    "input.delete": "delete,shift+delete",
    "input.delete.to.line.start": "none",
    "session.delete": "none"
  },
  "animations": true,
  "session": {
    "scrollbar": true,
    "thinking": "show",
    "permissions": "prompt",
    "sidebar": "hide",
    "new_location": "launch"
  },
  "prompt": {
    "image_preview": true
  },
  "diffs": {
    "tree": true,
    "view": "split",
    "fullscreen": true,
    "single": false
  }
}
