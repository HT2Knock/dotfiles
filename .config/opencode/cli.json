{
  "$schema": "https://opencode.ai/v2/cli.json",
  "keybinds": {
    "session.half.page.up": "ctrl+u",
    "session.half.page.down": "ctrl+d"
  },
  "theme": {
    "name": "tokyonight"
  },
  "animations": true,
  "session": {
    "scrollbar": true,
    "thinking": "show",
    "permissions": "prompt"
  },
  "tabs": {
    "scope": "cwd"
  },
  "attention": {
    "notifications": true,
    "sound": true,
    "volume": 0.4,
    "sound_pack": "opencode.default"
  },
  "plugins": [
    "./herdr-opencode"
  ],
  "prompt": {
    "image_preview": true
  }
}
